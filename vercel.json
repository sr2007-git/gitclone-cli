{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "auth-config.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api|assets|favicon.ico|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}
